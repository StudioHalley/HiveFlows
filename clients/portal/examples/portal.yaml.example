# portal-client configuration
# Generated by `portal-client init` — edit to add your services.

# WebSocket URL of the HiveFlows portal server
server_url: wss://hiveflows.example.com/portal/ws

# Identity (filled by `portal-client init`)
workspace: acme
device_slug: nas-maison
token: <permanent_token_here>

# Services this device exposes — ONLY these names are accepted.
# The client will refuse any REQUEST for a service not listed here.
services:
  - name: homeassistant
    route: http://192.168.1.20:8123
  - name: vlc
    route: http://127.0.0.1:8004
  # - name: another-service
  #   route: http://localhost:9000
