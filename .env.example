# =============================================================================
# LLM — OpenRouter (compatible OpenAI API)
# https://openrouter.ai/keys
# =============================================================================
OPENROUTER_API_KEY=sk-or-...
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# =============================================================================
# Credential Vault (Phase 5) — chiffrement Fernet des clés provider
# Générer: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================
CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# Auth — API Keys internes (séparées par virgule, rétro-compatible)
# =============================================================================
API_KEYS=dev-key-1,dev-key-2

# =============================================================================
# API Server (proxy LLM par workspace) — réseaux depuis lesquels le token
# workspace_id est accepté tel quel (apps internes Beekeeper).
# Hors de ces réseaux, une clé API du workspace (hf_...) est exigée.
# =============================================================================
LLM_PROXY_TRUSTED_NETWORKS=172.16.0.0/12,127.0.0.0/8

# =============================================================================
# Auth — JWT (Phase 4)
# =============================================================================
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# OAuth2 (Phase 4 — laisser vide pour désactiver)
# =============================================================================
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://beta.hiveflows.com

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hiveflows
POSTGRES_USER=hiveflows
POSTGRES_PASSWORD=changeme

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Celery
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =============================================================================
# Core Service
# =============================================================================
CORE_HOST=0.0.0.0
CORE_PORT=8000
LOG_LEVEL=INFO

# =============================================================================
# Beekeeper (Phase 6) — Docker Control Plane
# Clé partagée entre Core et Beekeeper (header X-Beekeeper-Key)
# Générer: python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================
BEEKEEPER_API_KEY=change-me-beekeeper-key

# =============================================================================
# Workspace Data Path — répertoire hôte monté dans core, worker et beekeeper
# Peut être relatif (pour docker compose volumes) ou absolu.
# =============================================================================
WORKSPACE_DATA_PATH=./workspace_data

# Chemin ABSOLU vers workspace_data sur l'hôte Docker.
# Transmis au beekeeper pour construire les specs volumes des containers d'apps.
# Doit correspondre à WORKSPACE_DATA_PATH mais en chemin absolu.
# Exemple: /home/patrick/hiveflows/workspace_data
WORKSPACE_DATA_HOST_DIR=/home/patrick/hiveflows/workspace_data

# =============================================================================
# Self-update depuis l'UI (optionnel) — permet à beekeeper de lancer
# scripts/update.sh (git pull + rebuild core/worker + migrations).
# Laisser vide pour DÉSACTIVER le self-update UI (la mise à jour reste possible
# en CLI/SSH via ./scripts/update.sh).
# =============================================================================
# Chemin ABSOLU du repo sur l'hôte — monté à l'identique dans beekeeper.
# Exemple: /home/patrick/hiveflows
HIVE_REPO_HOST_DIR=
# Dossier SSH de l'hôte (clé autorisée à pull depuis Gitea), monté en lecture seule.
# Exemple: /home/patrick/.ssh
HIVE_SSH_DIR=

